<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>com.finora</groupId>
  <artifactId>finora-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Finora AI</name>
  <description>Finora AI services (owner-approved: microservices, Java 21, Spring Boot 4.1.2, Maven, Flyway, PostgreSQL)</description>

  <properties>
    <resilience4j.version>2.4.0</resilience4j.version>
    <bouncycastle.version>1.86</bouncycastle.version>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
  </properties>

  <modules>
    <module>libs/finance-core</module>
    <module>libs/service-commons</module>
    <module>libs/service-testkit</module>
    <module>services/api-gateway</module>
    <module>services/identity-access</module>
    <module>services/finance</module>
    <module>services/document</module>
    <module>services/ingestion-integration</module>
    <module>services/reporting</module>
    <module>services/intelligence</module>
    <module>services/platform</module>
    <module>services/audit</module>
    <module>services/admin-plane</module>
    <!-- Must stay last: needs the packaged service jars. -->
    <module>tests/e2e</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.finora</groupId>
        <artifactId>finance-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.finora</groupId>
        <artifactId>service-commons</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.resilience4j</groupId>
        <artifactId>resilience4j-circuitbreaker</artifactId>
        <version>${resilience4j.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.resilience4j</groupId>
        <artifactId>resilience4j-bulkhead</artifactId>
        <version>${resilience4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.bouncycastle</groupId>
        <artifactId>bcprov-jdk18on</artifactId>
        <version>${bouncycastle.version}</version>
      </dependency>
      <dependency>
        <groupId>com.finora</groupId>
        <artifactId>service-testkit</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-toolchain</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,)</version>
                  <message>Finora requires JDK 21 or newer (compiled with --release 21).</message>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9.0,)</version>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <release>${java.version}</release>
          <showWarnings>true</showWarnings>
          <failOnWarning>true</failOnWarning>
          <compilerArgs>
            <arg>-Xlint:all,-processing</arg>
          </compilerArgs>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
