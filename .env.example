# Finora AI - environment placeholders. Copy to .env (git-ignored) for local use.
# NEVER commit real values. Passwords below are placeholders, not secrets.

# --- PostgreSQL for local development and tests (tools/dev-postgres.sh) ---
FINORA_DEV_DB_PASSWORD=CHANGE_ME_LOCAL_ONLY
FINORA_DB_HOST=localhost
FINORA_DB_PORT=5433
FINORA_PG_PORT=5433
# FINORA_PG_DATA=/path/to/local/postgres-data
# FINORA_PG_BIN=/usr/lib/postgresql/16/bin

# --- Per-service overrides (all optional; defaults are in each service's application.yml) ---
# Each service connects as its own runtime role and migrates as its own migrator role.
# SERVER_ADDRESS=127.0.0.1        # services are private (loopback) by default
# SERVER_PORT=8082
# DB_URL=jdbc:postgresql://localhost:5433/finora_finance
# DB_USER=finora_finance_app
# DB_PASSWORD=CHANGE_ME
# DB_MIGRATION_URL=jdbc:postgresql://localhost:5433/finora_finance
# DB_MIGRATION_USER=finora_finance_migrator
# DB_MIGRATION_PASSWORD=CHANGE_ME

# --- Internal service authentication (generate with tools/gen-dev-keys.sh; local development only) ---
# FINORA_KEYS_DIR=/absolute/path/to/.dev-keys
# --- Authentication (identity-access and gateway) ---
# FINORA_COOKIE_SECURE=true               # set false ONLY for plain-HTTP local development
# FINORA_ALLOWED_ORIGINS=http://localhost:3000   # browser origins allowed to make state-changing requests
# FINORA_AUTH_IDLE_TIMEOUT=30m
# FINORA_AUTH_ABSOLUTE_TIMEOUT=12h
# FINORA_MFA_KEY_PATH=/absolute/path/to/mfa.key   # base64 256-bit key encrypting TOTP secrets (tools/gen-dev-keys.sh creates one); MFA is unavailable without it
# FINORA_WEB_BASE_URL=http://localhost:3000       # used to build invitation links
# FINORA_INVITATIONS_DEV_OUTBOX_FILE=/tmp/invitations.jsonl   # DEVELOPMENT ONLY: capture invitation links locally; nothing is emailed
# GATEWAY_URL=http://127.0.0.1:8080               # web app -> gateway proxy target (server-side only)
# No email provider is configured: password-reset delivery is unavailable until one is chosen.

# --- Gateway downstream addresses (defaults are loopback ports; services stay private) ---
# IDENTITY_ACCESS_URL=http://127.0.0.1:8081
# FINANCE_URL=http://127.0.0.1:8082
# (also DOCUMENT_URL, INGESTION_INTEGRATION_URL, REPORTING_URL, INTELLIGENCE_URL, PLATFORM_URL, AUDIT_URL)

# AI provider keys are intentionally absent: no provider is approved yet.
